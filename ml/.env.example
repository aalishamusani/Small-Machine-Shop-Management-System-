# Copy to .env and fill in real values. Same database, same credentials
# as backend/.env — this script reads directly from Postgres rather than
# going through the Node API, since it's an internal batch job, not a
# request a client makes.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=smsms_db
PGUSER=smsms_app
PGPASSWORD=change_me
